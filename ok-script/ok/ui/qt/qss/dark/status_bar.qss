StatusBar {
    background-color: --ThemeColorDark1;
    border: none;
    border-radius: 7px;
}

QLabel {
    color: black;
    background-color: transparent;
    font-family: -apple-system, '.AppleSystemUIFont', 'PingFang SC', 'Segoe UI', 'Microsoft YaHei';
    border: none;
}

QLabel#titleLabel {
    color: white;
    font: 14px -apple-system, '.AppleSystemUIFont', 'PingFang SC', 'Segoe UI', 'Microsoft YaHei';
    font-weight: bold;
}

QLabel#contentLabel {
    color: rgb(208, 208, 208);
    font: 12px -apple-system, '.AppleSystemUIFont', 'PingFang SC', 'Segoe UI', 'Microsoft YaHei';
}